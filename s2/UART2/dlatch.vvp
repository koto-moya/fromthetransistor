    %load/vec4 v0x600001490240_0;
    %pad/s 1;
    %assign/vec4 v0x600001490510_0, 0;
    %load/vec4 v0x600001490510_0;
    %store/vec4 v0x600001490000_0, 0, 1;
    %load/vec4 v0x6000014905a0_0;
    %store/vec4 v0x600001490090_0, 0, 1;
    %load/vec4 v0x600001490750_0;
    %store/vec4 v0x6000014901b0_0, 0, 1;
    %load/vec4 v0x6000014906c0_0;
    %store/vec4 v0x600001490120_0, 0, 1;
    %fork TD_tb_dlatch.checker, S_0x156e08870;
    %join;
    %load/vec4 v0x6000014906c0_0;
    %assign/vec4 v0x600001490630_0, 0;
    %load/vec4 v0x600001490240_0;
