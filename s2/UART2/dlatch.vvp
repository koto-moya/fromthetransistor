    %vpi_call 2 64 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x156e08540 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x600001490510_0, 0;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x6000014905a0_0, 0;
